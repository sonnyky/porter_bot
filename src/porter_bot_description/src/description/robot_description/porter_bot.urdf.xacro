<?xml version="1.0"?>
<robot name="porter_bot" xmlns:xacro="http://wwww.ros.org/wiki/xacro">

    <xacro:include filename="$(find porter_bot_description)/src/description/robot_description/common_properties.xacro" />
    <xacro:include filename="$(find porter_bot_description)/src/description/robot_description/mobile_base.xacro" />
    <xacro:include filename="$(find porter_bot_description)/src/description/robot_description/mobile_base_gazebo.xacro" />
    <xacro:include filename="$(find porter_bot_description)/src/description/robot_description/arm.xacro" />
    <xacro:include filename="$(find porter_bot_description)/src/description/robot_description/arm_gazebo.xacro" />

     <joint name="mobile_base_arm_joint" type="fixed">
        <parent link="base_link" />
        <child link="arm_base_link" />
        <origin xyz="${base_length/4.0} 0 ${base_height}" rpy="0 0 0" />
       
    </joint>

<!--     <xacro:include filename="$(find porter_bot_description)/src/description/robot_description/camera.xacro" />
 -->
</robot>